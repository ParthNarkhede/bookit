rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDoc().data.role == 'admin';
    }

    function isEligibleUserEmail(emailValue) {
      return emailValue is string
        && exists(/databases/$(database)/documents/eligibleUsers/$(emailValue.lower()))
        && get(/databases/$(database)/documents/eligibleUsers/$(emailValue.lower())).data.email == emailValue.lower()
        && get(/databases/$(database)/documents/eligibleUsers/$(emailValue.lower())).data.registeredAt == null;
    }

    function isValidBookingStatus(status) {
      return status in ['confirmed', 'hold', 'cancelled'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.role in ['employee', 'admin']
        && isEligibleUserEmail(request.resource.data.email);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidBookingStatus(request.resource.data.status)
        && request.resource.data.roomId is string;
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /eligibleUsers/{emailId} {
      allow read: if true;
      allow create: if isAdmin();
      allow delete: if isAdmin() && resource.data.registeredAt == null;
      allow update: if isAdmin()
        || (
          isSignedIn()
          && emailId == request.auth.token.email.lower()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredAt'])
          && request.resource.data.registeredAt is number
        );
    }
  }
}
